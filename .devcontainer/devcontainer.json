{
  "name": "PaperWeave",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": {
      "label": "PaperWeave",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "postStartCommand": "nohup python search/app.py --host 0.0.0.0 --port 8765 --no-browser > /tmp/paperweave.log 2>&1 &"
}
