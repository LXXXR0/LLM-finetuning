{
  "name": "paperweave-launcher",
  "displayName": "PaperWeave Launcher",
  "description": "Open the local PaperWeave literature workspace inside VS Code.",
  "version": "0.1.0",
  "publisher": "local",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished", "onCommand:paperweave.open"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "paperweave.open",
        "title": "Open PaperWeave",
        "category": "PaperWeave"
      }
    ]
  }
}
